# Что НЕ уходит в build context докера.
# Dockerfile копирует только pom.xml и src/, но контекст целиком отправляется демону —
# вместе с .env и историей git. Список зеркалит .gitignore плюс .git.

# Секреты
.env
.env.local
*.pem
*.key

# История git (в сборке не нужна)
.git

# Сборка (jar собирается внутри build-стейджа, локальный target только ломает кэш слоёв)
target/

# Локальная база
data/

# Служебное
.idea/
.vscode/
*.log
