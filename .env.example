# Шаблон .env — скопировать в .env и подставить свои значения:
#   cp .env.example .env
#
# Сам .env в git не попадает (.gitignore) и не уходит в build context докера
# (.dockerignore). Здесь только плейсхолдеры — реальные ключи сюда не писать.
#
# Обязательный минимум для старта: BOT_TOKEN, BOT_USERNAME, DB_*, YOOKASSA_*.
# У остальных переменных в application.yml есть значения по умолчанию.


# ───────────────────────── Telegram-бот ─────────────────────────

# Токен бота от @BotFather.
# Пока токена нет, docker-compose поднимает приложение с профилем nobot: всё работает,
# кроме подписки на обновления Telegram (иначе стартер роняет старт с 401). Появился
# настоящий токен — очистите SPRING_PROFILES_ACTIVE внизу этого файла.
BOT_TOKEN=
# Username бота без «@» — из него строятся deep-ссылки (например, реферальные).
BOT_USERNAME=
# Telegram ID владельца: кому доступны админ-команды и кому уходят алерты.
# Пусто — админ-команды заблокированы для всех.
OWNER_TELEGRAM_ID=
# Публичный base URL бэкенда: из него строятся абсолютные ссылки на наши эндпоинты
# (выдача доступа, magic-link, веб-кабинет, returnUrl эквайринга).
BOT_PUBLIC_BASE_URL=https://example.com
# Отдельный домен только для кнопок открытия Mini App. Пусто — берётся BOT_PUBLIC_BASE_URL.
MINI_APP_BASE_URL=
# Ссылка на инструкцию «как подключиться». Пусто — экран показывается без неё.
GUIDE_URL=
# Контакт поддержки (обычно https://t.me/<username>). Пусто — кнопка скрыта.
SUPPORT_URL=
# file_id ролика «как подключиться» (не путь к файлу: Telegram хранит видео у себя).
HOW_TO_VIDEO_ID=
# Анимированные custom-эмодзи в сообщениях. Работают, только если у аккаунта-владельца
# бота есть Telegram Premium; иначе оставить false — бот выглядит прилично и без них.
EMOJI_ENABLED=false


# ───────────────────────── Каналы ─────────────────────────

# Канал с новостями сервиса — кнопка в боте и в Mini App.
NEWS_CHANNEL_URL=
# Канал, подписка на который ОБЯЗАТЕЛЬНА для входа в бот (@username или числовой -100…).
# Пусто — гейт выключен. ⚠️ Бот обязан быть АДМИНИСТРАТОРОМ этого канала, иначе проверка
# членства падает и пропускает всех (fail-open, в логах «Channel membership check failed»).
REQUIRED_CHANNEL=
# Ссылка кнопки «Подписаться». Пусто — выводится из REQUIRED_CHANNEL (@name → t.me/name).
# Заполнять только для закрытого канала: туда ведёт invite-ссылка, из числового id её не собрать.
REQUIRED_CHANNEL_URL=


# ───────────────────────── База данных ─────────────────────────

# Имя базы, пользователь и пароль. Те же значения читает docker-compose при подъёме Postgres.
DB_NAME=subscriptions
DB_USER=app
DB_PASS=


# ───────────────────────── Эквайринг (ЮKassa) ─────────────────────────

# Идентификатор магазина и секретный ключ из личного кабинета ЮKassa.
# В application.yml у них НЕТ значений по умолчанию — без них старт упадёт.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда возвращается плательщик после оплаты (обычно ссылка на бота).
YOOKASSA_RETURN_URL=https://example.com/payment/return
# Автоплатежи (сохранение метода оплаты) включаются отдельной заявкой в поддержку эквайринга.
# false — UI автопродления скрыт, планировщик списаний спит.
YOOKASSA_RECURRENT_ENABLED=false
# HTTP-прокси до API эквайринга. Пусто — ходим напрямую, это обычный режим.
YOOKASSA_PROXY_HOST=
YOOKASSA_PROXY_PORT=3128


# ───────────────────────── Оплата криптовалютой (опционально) ─────────────────────────

# Токен Crypto Pay API. Пусто — способ оплаты скрыт.
CRYPTOBOT_TOKEN=
CRYPTOBOT_BASE_URL=https://pay.crypt.bot/api/
CRYPTOBOT_ASSETS=USDT,TON,BTC,ETH
# Deep-link, который CryptoBot покажет на экране успеха (обычно ссылка на бота).
CRYPTOBOT_PAID_BTN_URL=


# ───────────────────────── Провайдер доступа ─────────────────────────

# В этом репозитории за интерфейсом AccessProvider стоит локальная реализация
# (LocalAccessProvider): она выдаёт токен и наружу не ходит, поэтому base-url/креды
# ей не нужны. Переменные оставлены как контракт для реализации поверх реального вендора.
PROVIDER_BASE_URL=http://localhost:8000
PROVIDER_USER=
PROVIDER_PASS=
# Префикс подписочных ссылок: <prefix>/sub/<token> — адрес, по которому клиентское
# приложение забирает параметры доступа.
PROVIDER_SUBSCRIPTION_URL_PREFIX=https://example.com


# ───────────────────────── Узлы раздачи ─────────────────────────

# Ключ HMAC, из которого выводятся персональные учётные данные подписчика на узлах.
# Пусто — авторизация на узлах выключена, эндпоинт /node/auth/* отвечает 404.
# Сгенерировать: openssl rand -base64 32
NODE_AUTH_SECRET=
# Неугадываемый сегмент пути эндпоинта авторизации: узел может не уметь слать
# кастомные заголовки, поэтому «свой» подтверждается самим адресом.
NODE_AUTH_PATH_SECRET=
# Токен, которым узел-релей подписывает отчёты о живых соединениях
# (POST /api/internal/node-stats). Пусто — эндпоинт отвечает 404.
NODE_STATS_TOKEN=


# ───────────────────────── Почта (опционально) ─────────────────────────

# SMTP-доступ для писем: вход по magic-link, копия параметров доступа, уведомления.
# EMAIL_ENABLED=false — письма только логируются («would send»), реально не уходят.
EMAIL_ENABLED=false
# Отправитель. Должен совпадать с доменом, подтверждённым у SMTP-провайдера (DKIM/SPF/DMARC).
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=


# ───────────────────────── Оферта (опционально) ─────────────────────────

# URL публичной оферты. Пусто — /terms сообщает, что оферта в подготовке.
OFFER_URL=
# Метка редакции оферты (обычно дата). Пишется в offer_acceptances.offer_revision при
# акцепте. Менять ОДНОВРЕМЕННО с текстом оферты.
OFFER_REVISION=


# ───────────────────────── Мониторинг (опционально) ─────────────────────────

# Публичная статус-страница Uptime Kuma — источник статуса узлов для экрана
# «Статус серверов». false — экран показывает инвентарь из app.servers без живого статуса.
STATUS_PAGE_ENABLED=false
STATUS_PAGE_URL=http://127.0.0.1:3001
STATUS_PAGE_SLUG=orchestra


# ───────────────────────── Периодические задачи ─────────────────────────

# Каждый флаг гасит свою задачу независимо — на случай, когда одна из них мешает
# разбирать инцидент, а остальные должны продолжать работать.
SCHED_EXPIRY_ENABLED=true
SCHED_AUTORENEW_ENABLED=true
SCHED_RECONCILE_ENABLED=true
SCHED_PARKED_REMINDER_ENABLED=true
SCHED_RETENTION_ENABLED=true


# ───────────────────────── Прочее ─────────────────────────

# Путь к «горячему» конфигу (список узлов), который применяется командой /reloadconfig
# без пересборки образа. Файла нет — используются значения из application.yml.
APP_DYNAMIC_CONFIG_PATH=/opt/subscription-service/config/app-dynamic.yml
# Профили Spring. Пусто — обычный режим с регистрацией бота. `nobot` — всё, кроме
# long polling (значение по умолчанию в docker-compose.yml, см. BOT_TOKEN выше).
SPRING_PROFILES_ACTIVE=nobot
# Токен ТЕСТОВОГО бота для профиля dev (application-dev.yml). С боевым BOT_TOKEN не связан.
TEST_BOT_TOKEN=
TEST_BOT_USERNAME=
